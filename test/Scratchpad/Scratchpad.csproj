<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <DebugType>embedded</DebugType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="System.Reflection.Metadata" />
        
        <ProjectReference Include="../../src/Windows10CE.InlineIL/Windows10CE.InlineIL.csproj" />
        <ProjectReference Include="../../src/Windows10CE.InlineIL.PortablePdb/Windows10CE.InlineIL.PortablePdb.csproj" />
        <ProjectReference Include="../../src/Windows10CE.InlineIL.Task/Windows10CE.InlineIL.Task.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>
    
    <UsingTask TaskName="Windows10CE.InlineIL.Task.InlineILTask" AssemblyFile="$(ArtifactsPath)/bin/Windows10CE.InlineIL.Task/$([System.String]::new($(Configuration)).ToLower())/Windows10CE.InlineIL.Task.dll" />

    <Target Name="InlineIL" AfterTargets="CoreCompile">
        <InlineILTask InputPath="@(IntermediateAssembly)" References="@(ReferencePath)" OutputPath="@(IntermediateAssembly)" TargetFramework="$(TargetFramework)" DebugType="$(DebugType)" PdbFile="$(PdbFile)" />
        
        <ItemGroup>
            <FileWrites Include="@(IntermediateAssembly)" />
        </ItemGroup>
    </Target>
    
</Project>
